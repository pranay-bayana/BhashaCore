# Required in production: a long random value, never commit the real value.
FLASK_SECRET_KEY=
APP_ENV=production
# Supabase Transaction Pooler example. SQLite is local development only.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
BHASHACORE_LLM_TIMEOUT=300
# Verified Sarvam streaming provider. Select it for live generation after
# configuring a valid server-side SARVAM_API_KEY.
GENERATION_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-105b-conversations
SESSION_COOKIE_SECURE=true
TRUSTED_HOSTS=app.example.com
# Required for multi-worker production rate limiting. Local development may use memory://.
REDIS_URL=redis://redis-host:6379/0
APP_BASE_URL=https://app.example.com
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=
