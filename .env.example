# Required in production: a long random value, never commit the real value.
FLASK_SECRET_KEY=
APP_ENV=production
# PostgreSQL example. SQLite is local development only.
DATABASE_URL=postgresql+psycopg://bhashacore:password@db-host:5432/bhashacore
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
BHASHACORE_LLM_TIMEOUT=300
SESSION_COOKIE_SECURE=true
TRUSTED_HOSTS=app.example.com
# Required for multi-worker production rate limiting. Local development may use memory://.
REDIS_URL=redis://redis-host:6379/0
APP_BASE_URL=https://app.example.com
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=
